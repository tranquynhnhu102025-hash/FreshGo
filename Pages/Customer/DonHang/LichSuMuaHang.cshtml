@page
@* @model FreshGo.Pages.Customer.DonHang.LichSuMuaHangModel *@
@{
    ViewData["Title"] = "Đơn Mua Của Tôi";
    Layout = "_CustomerLayout";
}

<div class="container py-5 mt-3">
    <div class="row g-4">
        <!-- CỘT TRÁI: MENU TÀI KHOẢN -->
        <div class="col-lg-3">
            <div class="d-flex align-items-center gap-3 mb-4 px-2">
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 50px; height: 50px;">
                    TK
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Khách Trần B</h6>
                    <span class="text-muted small"><i class="bi bi-pencil-square"></i> Sửa hồ sơ</span>
                </div>
            </div>
            
            <div class="list-group border-0 shadow-sm rounded-4 overflow-hidden">
                <a asp-page="/Customer/TaiKhoan/HoSo" class="list-group-item list-group-item-action py-3 fw-medium text-dark">
                    <i class="bi bi-person-circle me-2"></i> Hồ sơ của tôi
                </a>
                <a asp-page="/Customer/TaiKhoan/DoiMatKhau" class="list-group-item list-group-item-action py-3 fw-medium text-dark">
                    <i class="bi bi-shield-lock me-2"></i> Đổi mật khẩu
                </a>
                <a asp-page="/Customer/DonHang/LichSuMuaHang" class="list-group-item list-group-item-action active bg-success border-success py-3 fw-medium">
                    <i class="bi bi-receipt me-2"></i> Đơn mua của tôi
                </a>
            </div>
        </div>

        <!-- CỘT PHẢI: DANH SÁCH ĐƠN HÀNG -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom p-4 rounded-top-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-black m-0" style="font-weight: 800;">Đơn Mua Của Tôi</h5>
                        <p class="text-muted m-0 mt-1">Quản lý và theo dõi trạng thái các đơn hàng bạn đã đặt</p>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Tab Trạng Thái -->
                    <div class="d-flex overflow-auto border-bottom px-3 scrollbar-none" style="white-space: nowrap;">
                        <a href="#" class="text-decoration-none px-4 py-3 border-bottom border-3 border-success text-success fw-bold">Tất cả</a>
                        <a href="#" class="text-decoration-none px-4 py-3 border-bottom border-3 border-transparent text-dark fw-medium hover-opacity">Chờ duyệt</a>
                        <a href="#" class="text-decoration-none px-4 py-3 border-bottom border-3 border-transparent text-dark fw-medium hover-opacity">Đang giao</a>
                        <a href="#" class="text-decoration-none px-4 py-3 border-bottom border-3 border-transparent text-dark fw-medium hover-opacity">Đã giao</a>
                        <a href="#" class="text-decoration-none px-4 py-3 border-bottom border-3 border-transparent text-dark fw-medium hover-opacity">Đã hủy</a>
                    </div>

                    <!-- Mẫu Đơn hàng 1 -->
                    <div class="p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light">
                            <span class="fw-bold text-dark"><i class="bi bi-box-seam me-2"></i>Mã đơn: #FG20261108</span>
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold"><i class="bi bi-truck me-1"></i> Đang giao hàng</span>
                        </div>
                        
                        <div class="d-flex gap-3 align-items-center mb-3">
                            <img src="https://images.unsplash.com/photo-1598170845058-32b9d6a5da37?w=150" class="rounded-3 object-fit-cover shadow-sm" style="width: 70px; height: 70px;">
                            <div class="flex-grow-1">
                                <h6 class="fw-bold mb-1">Cà chua VietGAP</h6>
                                <span class="text-muted small">Số lượng: 2 Kg</span>
                            </div>
                            <div class="text-end">
                                <span class="fw-semibold text-dark">50,000đ</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-light">
                            <span class="text-muted small">Ngày đặt: 08/11/2026 14:30</span>
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold text-dark">Thành tiền: <span class="fs-4 text-success fw-black">50,000đ</span></span>
                                <a asp-page="/Customer/DonHang/TheoDoiDon" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">Xem Chi Tiết</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>