@page
@* @model FreshGo.Pages.Customer.DonHang.TheoDoiDonHangModel *@
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    Layout = "_CustomerLayout";
}

<style>
    /* CSS cho thanh Tiến độ đơn hàng */
    .timeline-steps { display: flex; justify-content: space-between; position: relative; margin: 40px 0 20px; }
    .timeline-steps::before {
        content: ''; position: absolute; top: 15px; left: 0; right: 0; height: 4px;
        background-color: #e9ecef; z-index: 1;
    }
    .timeline-steps .progress-bar-fill {
        position: absolute; top: 15px; left: 0; height: 4px;
        background-color: #10b981; z-index: 2; width: 50%; /* Chỉnh % để thanh chạy */
    }
    .step { position: relative; z-index: 3; text-align: center; width: 25%; }
    .step-icon {
        width: 35px; height: 35px; border-radius: 50%; background-color: #e9ecef;
        display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;
        color: #adb5bd; font-size: 1.2rem; border: 4px solid #fff;
    }
    .step.active .step-icon { background-color: #10b981; color: #fff; box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2); }
    .step-text { font-size: 0.85rem; font-weight: 600; color: #6c757d; }
    .step.active .step-text { color: #10b981; }
</style>

<div class="container py-5 mt-3">
    <div class="row g-4">
        <!-- CỘT TRÁI: MENU TÀI KHOẢN -->
        <div class="col-lg-3">
            <div class="d-flex align-items-center gap-3 mb-4 px-2">
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 50px; height: 50px;">
                    TK
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Khách Trần B</h6>
                    <span class="text-muted small"><i class="bi bi-pencil-square"></i> Sửa hồ sơ</span>
                </div>
            </div>
            
            <div class="list-group border-0 shadow-sm rounded-4 overflow-hidden">
                <a asp-page="/Customer/TaiKhoan/HoSo" class="list-group-item list-group-item-action py-3 fw-medium text-dark">
                    <i class="bi bi-person-circle me-2"></i> Hồ sơ của tôi
                </a>
                <a asp-page="/Customer/TaiKhoan/DoiMatKhau" class="list-group-item list-group-item-action py-3 fw-medium text-dark">
                    <i class="bi bi-shield-lock me-2"></i> Đổi mật khẩu
                </a>
                <a asp-page="/Customer/DonHang/LichSuMuaHang" class="list-group-item list-group-item-action active bg-success border-success py-3 fw-medium">
                    <i class="bi bi-receipt me-2"></i> Đơn mua của tôi
                </a>
            </div>
        </div>

        <!-- CỘT PHẢI: CHI TIẾT ĐƠN HÀNG -->
        <div class="col-lg-9">
            <div class="d-flex align-items-center mb-3">
                <a asp-page="/Customer/DonHang/LichSuMuaHang" class="text-success text-decoration-none fw-bold me-3">
                    <i class="bi bi-chevron-left"></i> Trở lại
                </a>
                <h5 class="fw-black m-0 border-start border-2 border-success ps-3">Chi Tiết Đơn Hàng #FG20261108</h5>
            </div>

            <!-- Thanh Tiến Độ -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <h6 class="fw-bold mb-0">Trạng Thái Giao Hàng</h6>
                <div class="timeline-steps">
                    <div class="progress-bar-fill"></div>
                    <div class="step active">
                        <div class="step-icon"><i class="bi bi-receipt"></i></div>
                        <div class="step-text">Đã đặt hàng<br><small class="fw-normal text-muted">14:30 08/11</small></div>
                    </div>
                    <div class="step active">
                        <div class="step-icon"><i class="bi bi-box-seam"></i></div>
                        <div class="step-text">Đã xác nhận<br><small class="fw-normal text-muted">15:00 08/11</small></div>
                    </div>
                    <div class="step active">
                        <div class="step-icon"><i class="bi bi-truck"></i></div>
                        <div class="step-text">Đang giao<br><small class="fw-normal text-muted">Shipper đã nhận</small></div>
                    </div>
                    <div class="step">
                        <div class="step-icon"><i class="bi bi-check2-circle"></i></div>
                        <div class="step-text">Đã nhận hàng</div>
                    </div>
                </div>
            </div>

            <!-- Thông tin địa chỉ & Sản phẩm -->
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-success bg-opacity-10 border border-success border-opacity-25">
                        <h6 class="fw-bold text-success mb-3"><i class="bi bi-geo-alt-fill me-2"></i>Địa Chỉ Nhận Hàng</h6>
                        <h6 class="fw-bold mb-1">Khách Trần B</h6>
                        <p class="text-muted small mb-2">(+84) 900 000 004</p>
                        <p class="mb-0 small fw-medium">Số 123 Đường Nguyễn Trãi, Quận 1, TP. Hồ Chí Minh</p>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4">
                        <h6 class="fw-bold mb-3 border-bottom pb-2">Thông Tin Thanh Toán</h6>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Tổng tiền hàng:</span>
                            <span class="fw-semibold">50,000đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span class="text-muted">Phí vận chuyển (Quận 1):</span>
                            <span class="fw-semibold">15,000đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 small">
                            <span class="text-muted">Voucher áp dụng:</span>
                            <span class="fw-semibold text-success">-0đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="fw-bold">Thành tiền:</span>
                            <span class="fw-black text-success fs-4">65,000đ</span>
                        </div>
                        <p class="text-end small text-muted mt-1 m-0">Thanh toán khi nhận hàng (COD)</p>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>