@page
@model FreshGo.Pages.Manager.ThongTinChiNhanhModel
@{
    ViewData["Title"] = "Thông tin chi nhánh";
    ViewData["Breadcrumb"] = "Thông tin chi nhánh";
}

@if (Model.KhongTimThay)
{
    <div class="alert alert-warning">Không tìm thấy dữ liệu chi nhánh trong CSDL.</div>
}
else
{
    <div class="manager-card" style="max-width:640px">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label class="form-label">Tên chi nhánh</label>
                <input asp-for="Form.TenChiNhanh" class="form-control" />
                <span asp-validation-for="Form.TenChiNhanh" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Khu vực / Quận</label>
                <input asp-for="Form.KhuVucQuan" class="form-control" />
                <span asp-validation-for="Form.KhuVucQuan" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Địa chỉ</label>
                <input asp-for="Form.DiaChi" class="form-control" />
                <span asp-validation-for="Form.DiaChi" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </form>
    </div>

    <h6 class="mt-4 mb-3">Hồ sơ quản lý chi nhánh</h6>
    @if (Model.QuanLy is null)
    {
        <div class="manager-card" style="max-width:640px">
            <div class="text-muted">Chưa có tài khoản Quản lý nào được gán cho chi nhánh này.</div>
        </div>
    }
    else
    {
        <div class="manager-card" style="max-width:640px">
            <dl class="row mb-0">
                <dt class="col-4">Họ tên</dt>
                <dd class="col-8">@Model.QuanLy.HoTen</dd>

                <dt class="col-4">Email</dt>
                <dd class="col-8">@Model.QuanLy.Email</dd>

                <dt class="col-4">Số điện thoại</dt>
                <dd class="col-8">@Model.QuanLy.SoDienThoai</dd>

                <dt class="col-4">CCCD</dt>
                <dd class="col-8">@(Model.QuanLy.CCCD ?? "—")</dd>
            </dl>
        </div>
    }

    <h6 class="mt-4 mb-3">Hồ sơ nhân viên</h6>
    @if (!Model.DanhSachNhanVienDongGoi.Any())
    {
        <div class="manager-card" style="max-width:640px">
            <div class="text-muted">Chi nhánh chưa có nhân viên nào.</div>
        </div>
    }
    else
    {
        @foreach (var nv in Model.DanhSachNhanVienDongGoi)
        {
            <div class="manager-card mb-3" style="max-width:640px">
                <dl class="row mb-0">
                    <dt class="col-4">Họ tên</dt>
                    <dd class="col-8">@nv.HoTen</dd>

                    <dt class="col-4">Email</dt>
                    <dd class="col-8">@nv.Email</dd>

                    <dt class="col-4">Số điện thoại</dt>
                    <dd class="col-8">@nv.SoDienThoai</dd>

                    <dt class="col-4">CCCD</dt>
                    <dd class="col-8">@(nv.CCCD ?? "—")</dd>
                </dl>
            </div>
        }
    }

    <h6 class="mt-4 mb-3">Hồ sơ nhân viên giao hàng</h6>
    @if (!Model.DanhSachNhanVien.Any())
    {
        <div class="manager-card" style="max-width:640px">
            <div class="text-muted">Chi nhánh chưa có nhân viên giao hàng nào.</div>
        </div>
    }
    else
    {
        @foreach (var nv in Model.DanhSachNhanVien)
        {
            <div class="manager-card mb-3" style="max-width:640px">
                <dl class="row mb-0">
                    <dt class="col-4">Họ tên</dt>
                    <dd class="col-8">@nv.HoTen</dd>

                    <dt class="col-4">Số điện thoại</dt>
                    <dd class="col-8">@nv.SoDienThoai</dd>

                    <dt class="col-4">Biển số xe</dt>
                    <dd class="col-8">@(nv.BienSoXe ?? "—")</dd>

                    <dt class="col-4">CCCD</dt>
                    <dd class="col-8">@(nv.CCCD ?? "—")</dd>
                </dl>
            </div>
        }
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
