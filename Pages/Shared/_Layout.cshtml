<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Siêu thị FreshGo</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Quicksand', 'sans-serif'], },
                    colors: { freshgo: '#10b981', organic: '#064e3b' }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Quicksand', sans-serif; background-color: #f4f8f5; }
        a { text-decoration: none !important; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-thumb { background: #a7f3d0; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #10b981; }
    </style>
</head>
<body class="flex flex-col min-h-screen m-0 p-0 text-gray-800">
    
    <!-- Floating Header -->
    <div class="sticky top-4 z-50 px-4">
        <header class="max-w-7xl mx-auto bg-white/70 backdrop-blur-xl border border-white shadow-[0_8px_30px_rgb(0,0,0,0.04)] rounded-full px-6 py-3 flex items-center justify-between gap-4">
            <!-- Logo -->
            <a asp-area="" asp-page="/Index" class="flex items-center gap-2 text-freshgo font-bold text-2xl tracking-tight hover:scale-105 transition-transform">
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                FreshGo
            </a>

            <!-- MENU ĐIỀU HƯỚNG -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-bold text-gray-600">
                <a asp-page="/Index" class="hover:text-freshgo transition-colors">Trang chủ</a>
                <a asp-page="/CuaHang" class="hover:text-freshgo transition-colors">Cửa hàng</a>
                <a asp-page="/KhuyenMai" class="hover:text-freshgo transition-colors">Khuyến mãi</a>
                <a asp-page="/BaiViet" class="hover:text-freshgo transition-colors">Bài viết</a>
            </nav>

            <!-- Thanh tìm kiếm -->
            <div class="hidden lg:flex flex-1 max-w-xs relative group">
                <input type="text" placeholder="Tìm kiếm..." class="w-full bg-emerald-50/50 text-gray-800 border-2 border-transparent rounded-full py-2 pl-5 pr-10 group-hover:bg-white focus:bg-white focus:border-freshgo focus:ring-0 outline-none transition-all font-medium text-sm placeholder-gray-400" />
                <button class="absolute right-1.5 top-1.5 p-1.5 bg-freshgo text-white rounded-full hover:bg-emerald-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </button>
            </div>

            <!-- Nút chức năng -->
            <div class="flex items-center gap-3">
                <a asp-page="/Manager/Index" class="hidden sm:flex items-center gap-1 text-sm font-bold text-gray-400 hover:text-freshgo transition-colors" title="Quản lý">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </a>
                
                <a asp-page="/GioHang" class="relative p-2 bg-emerald-50 rounded-full text-freshgo hover:bg-freshgo hover:text-white transition-all">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    <span class="absolute -top-1 -right-1 bg-rose-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full border-2 border-white shadow-sm">3</span>
                </a>
                
                <a asp-page="/DangNhap" class="bg-gray-800 text-white text-sm font-bold py-2.5 px-6 rounded-full hover:bg-freshgo transition-colors shadow-md whitespace-nowrap">Đăng nhập</a>
            </div>
        </header>
    </div>

    <!-- Nơi nội dung Index được bơm vào -->
    <main class="flex-grow -mt-20 pt-24">
        @RenderBody()
    </main>

    <!-- Footer Xanh rêu -->
    <footer class="bg-organic text-emerald-50 mt-16 rounded-t-[3rem] pt-16 pb-8 shadow-[0_-10px_40px_rgba(6,78,59,0.1)]">
        <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-10">
            <div class="md:col-span-2">
                <div class="flex items-center gap-2 text-white font-bold text-3xl mb-4">
                    <svg class="w-8 h-8 text-freshgo" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM9 19.5v-1.93c-1.1-.06-2-.96-2-2.07V15L4.21 12.07C4.08 12.65 4 13.25 4 13.93c0 4.08 3.05 7.44 7 7.93M20 12c0 4.42-3.58 8-8 8v-1.93c1.1-.06 2-.96 2-2.07V15l2.79-2.93c.13-.58.21-1.18.21-1.86M12 4c4.42 0 8 3.58 8 8 0 .68-.08 1.28-.21 1.86L17 15v1c0 1.1-.9 2-2 2h-6c-1.1 0-2-.9-2-2v-1l-2.79-2.93C4.08 11.49 4 10.89 4 10.21c0-4.42 3.58-8 8-8z"/></svg>
                    FreshGo
                </div>
                <p class="text-sm text-emerald-200/70 leading-relaxed font-medium pr-10">
                    Mang cả khu vườn nông sản tươi mát đến bàn ăn nhà bạn. Cam kết 100% hữu cơ, sạch và an toàn.
                </p>
            </div>
            <div>
                <h4 class="text-white font-bold mb-4 text-lg">Khám phá</h4>
                <ul class="space-y-3 text-sm font-medium text-emerald-200/80">
                    <li><a href="#" class="hover:text-white transition-colors">Về FreshGo</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">Sản phẩm</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-bold mb-4 text-lg">Hỗ trợ</h4>
                <ul class="space-y-3 text-sm font-medium text-emerald-200/80">
                    <li><a href="#" class="hover:text-white transition-colors">Chính sách giao hàng</a></li>
                    <li><a href="#" class="hover:text-white transition-colors">Hotline: 1900 8888</a></li>
                </ul>
            </div>
        </div>
        <div class="max-w-6xl mx-auto px-6 mt-12 pt-6 border-t border-emerald-800 text-sm font-medium text-emerald-400 text-center">
            <span>&copy; 2026 FreshGo - Developed with ❤️ by Quỳnh Như</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>