@page
@model FreshGo.Pages.Admin.Staff.IndexModel
@{
    ViewData["Title"] = "Quản lý nhân sự";
}
<div class="page-heading"><div><div class="eyebrow">PEOPLE & ACCESS</div><h1 class="h2 fw-bold">Quản lý nhân sự</h1><p class="text-secondary mb-0">Tạo tài khoản quản lý / shipper, khoá tài khoản và đặt lại mật khẩu.</p></div></div>
<div class="row g-3"><div class="col-lg-4"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Tạo tài khoản nhân viên</div><div class="card-body"><form method="post" asp-page-handler="Create"><div asp-validation-summary="All" class="text-danger small"></div><div class="mb-2"><label class="form-label">Họ tên</label><input asp-for="Input.FullName" class="form-control" required /></div><div class="mb-2"><label class="form-label">Email đăng nhập</label><input asp-for="Input.Email" type="email" class="form-control" required /></div><div class="mb-2"><label class="form-label">Vai trò</label><select asp-for="Input.Role" class="form-select"><option value="Manager">Quản lý</option><option value="Shipper">Shipper</option></select></div><div class="mb-2"><label class="form-label">Chi nhánh</label><select asp-for="Input.BranchId" asp-items="Model.BranchOptions" class="form-select"><option value="">-- Chọn chi nhánh --</option></select></div><div class="mb-3"><label class="form-label">Mật khẩu tạm</label><input asp-for="Input.Password" type="password" class="form-control" required /></div><button class="btn btn-success w-100">Tạo tài khoản</button></form></div></div></div>
<div class="col-lg-8"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Tài khoản hệ thống</div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nhân viên</th><th>Vai trò</th><th>Chi nhánh</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var u in Model.Users) { <tr><td><div class="fw-semibold">@u.FullName</div><small class="text-secondary">@u.Email</small></td><td>@u.Role</td><td>@u.BranchName</td><td>@(u.IsActive ? "Hoạt động" : "Đã khóa")</td><td><div class="d-flex flex-wrap gap-1"><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm btn-outline-secondary">@(u.IsActive ? "Khóa" : "Mở khóa")</button></form><form method="post" asp-page-handler="ResetPassword" class="d-flex gap-1"><input type="hidden" name="id" value="@u.Id"/><input name="newPassword" type="password" class="form-control form-control-sm" placeholder="Mật khẩu mới" required style="width:120px"/><button class="btn btn-sm btn-outline-primary">Đặt lại</button></form></div></td></tr> }</tbody></table></div></div></div></div>
