@page
@model FreshGo.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="page-heading"><div><div class="eyebrow">SYSTEM CONTROL</div><h1 class="h2 fw-bold">Tổng quan hệ thống</h1><p class="text-secondary mb-0">Xin chào Admin, đây là tình hình hoạt động FreshGo.</p></div><span class="role-pill role-admin">ADMIN</span></div>
<div class="row g-3 mb-4">
@foreach (var kpi in Model.Kpis) { <div class="col-6 col-xl-3"><div class="kpi-card"><div class="kpi-label">@kpi.Label</div><div class="kpi-value">@kpi.Value</div><div class="kpi-hint">@kpi.Hint</div></div></div> }
</div>
<div class="row g-3 mb-3"><div class="col-12"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Doanh thu theo chi nhánh</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Chi nhánh</th><th>Số đơn hoàn tất</th><th class="text-end">Doanh thu</th></tr></thead><tbody>@foreach (var b in Model.BranchRevenue) { <tr><td class="fw-semibold">@b.BranchName</td><td>@b.OrderCount</td><td class="text-end fw-bold text-success">@b.Revenue.ToString("N0") đ</td></tr> }</tbody></table></div></div></div></div>
<div class="row g-3"><div class="col-lg-7"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Đơn hàng gần đây</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã đơn</th><th>Chi nhánh</th><th>Ngày tạo</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th></tr></thead><tbody>@foreach (var order in Model.RecentOrders) { <tr><td class="fw-semibold">@order.OrderCode</td><td>@order.Branch?.Name</td><td>@order.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td><td><span class="status-pill">@order.Status</span></td><td class="text-end">@order.TotalAmount.ToString("N0") đ</td></tr> }</tbody></table></div></div></div>
<div class="col-lg-5"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Truy cập nhanh</div><div class="card-body d-grid gap-2"><a class="quick-link" asp-page="Products/Index">📦 Quản lý sản phẩm</a><a class="quick-link" asp-page="Orders/Index">🧾 Theo dõi toàn bộ đơn hàng</a><a class="quick-link" asp-page="StockRequests/Index">🚚 Duyệt yêu cầu nhập kho (@Model.PendingRequests)</a><a class="quick-link" asp-page="Branches/Index">🏬 Quản lý chi nhánh</a><a class="quick-link" asp-page="Staff/Index">👥 Quản lý nhân sự</a><a class="quick-link" asp-page="Vouchers/Index">🎟️ Chương trình voucher</a><a class="quick-link" asp-page="Events/Index">📣 Quản lý sự kiện</a><a class="quick-link" asp-page="Defects/Index">⚠️ Xác nhận hàng lỗi</a><a class="quick-link" asp-page="Gifts/Index">🎁 Quản lý quà đổi điểm</a></div></div></div></div>
