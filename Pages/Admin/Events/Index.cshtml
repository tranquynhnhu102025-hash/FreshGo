@page
@model FreshGo.Pages.Admin.Events.IndexModel
@{
    ViewData["Title"] = "Quản lý sự kiện";
}
<div class="page-heading"><div><div class="eyebrow">CAMPAIGNS & EVENTS</div><h1 class="h2 fw-bold">Quản lý sự kiện</h1><p class="text-secondary mb-0">Đăng sự kiện, chương trình khuyến mãi và thông báo đến khách hàng.</p></div></div>
<div class="row g-3"><div class="col-lg-4"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Tạo sự kiện</div><div class="card-body"><form method="post"><div asp-validation-summary="All" class="text-danger small"></div><div class="mb-2"><label class="form-label">Tiêu đề</label><input asp-for="Input.Title" class="form-control" required /></div><div class="mb-2"><label class="form-label">Mô tả</label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea></div><div class="mb-2"><label class="form-label">Ảnh (URL)</label><input asp-for="Input.ImageUrl" class="form-control" /></div><div class="mb-2"><label class="form-label">Bắt đầu</label><input asp-for="Input.StartAt" type="datetime-local" class="form-control" /></div><div class="mb-3"><label class="form-label">Kết thúc</label><input asp-for="Input.EndAt" type="datetime-local" class="form-control" /></div><button class="btn btn-success w-100">Đăng sự kiện</button></form></div></div></div>
<div class="col-lg-8"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Danh sách sự kiện</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Tiêu đề</th><th>Thời gian</th><th>Mô tả</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var e in Model.Events) { <tr><td class="fw-semibold">@e.Title</td><td class="small">@e.StartAt.ToLocalTime().ToString("dd/MM/yy") – @e.EndAt.ToLocalTime().ToString("dd/MM/yy")</td><td>@e.Description</td><td>@(e.IsActive ? "Đang hiển thị" : "Đã ẩn")</td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@e.Id"/><button class="btn btn-sm btn-outline-secondary">@(e.IsActive ? "Ẩn" : "Hiện")</button></form></td></tr> }</tbody></table></div></div></div></div>
