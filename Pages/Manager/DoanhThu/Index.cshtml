@page
@model FreshGo.Pages.Manager.DoanhThu.IndexModel
@{
    ViewData["Title"] = "Doanh thu";
    ViewData["Breadcrumb"] = "Doanh thu";
    var maxNgay = Model.TheoNgay.Count > 0 ? Model.TheoNgay.Max(x => x.DoanhThu) : 0;
}

<form method="get" class="flex flex-wrap items-end gap-3 mb-8">
    <div>
        <select name="khoangThoiGian" id="khoangThoiGian" class="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 focus:ring-2 focus:ring-freshgo focus:border-freshgo outline-none w-48 shadow-sm transition-all bg-white" onchange="capNhatHienThiTuyChon(); this.form.submit()">
            <option value="homnay" selected="@(Model.KhoangThoiGian == "homnay")">Hôm nay</option>
            <option value="7ngay" selected="@(Model.KhoangThoiGian == "7ngay")">7 ngày</option>
            <option value="thangnay" selected="@(Model.KhoangThoiGian == "thangnay")">Tháng</option>
            <option value="tatca" selected="@(Model.KhoangThoiGian == "tatca")">Tất cả</option>
            <option value="tuychon" selected="@(Model.KhoangThoiGian == "tuychon")">Tùy chọn</option>
        </select>
    </div>
    <div id="khoiTuyChon" class="items-end gap-3" style="display:flex;">
        <div class="flex flex-col">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Từ ngày</label>
            <input type="date" name="tuNgay" class="border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-700 focus:ring-2 focus:ring-freshgo focus:border-freshgo outline-none shadow-sm transition-all" value="@Model.TuNgayLoc.ToString("yyyy-MM-dd")" />
        </div>
        <div class="flex flex-col">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Đến ngày</label>
            <input type="date" name="denNgay" class="border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-700 focus:ring-2 focus:ring-freshgo focus:border-freshgo outline-none shadow-sm transition-all" value="@Model.DenNgayLoc.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded-lg transition-colors text-sm shadow-sm border border-gray-200">Áp dụng</button>
    </div>
</form>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="md:col-span-2 bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col justify-center">
        <div class="text-3xl font-bold text-gray-800">@Model.Summary.TongDoanhThu.ToString("N0")<span class="text-xl text-gray-500 font-medium ml-1">VNĐ</span></div>
        <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mt-1">Tổng doanh thu</div>
        <div class="mt-4 flex gap-6 text-sm text-gray-600 border-t border-gray-100 pt-3">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-freshgo"></span>
                Tiền mặt: <span class="font-medium text-gray-800">@Model.Summary.TongDoanhThuTienMat.ToString("N0")đ</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                Chuyển khoản: <span class="font-medium text-gray-800">@Model.Summary.TongDoanhThuChuyenKhoan.ToString("N0")đ</span>
            </div>
        </div>
    </div>
    <div class="md:col-span-1 bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col items-center justify-center text-center">
        <div class="text-4xl font-bold text-freshgo">@Model.Summary.SoDonHoanTat</div>
        <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mt-2">Đơn hoàn tất</div>
    </div>
    <div class="md:col-span-1 bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex flex-col items-center justify-center text-center">
        <div class="text-4xl font-bold text-red-500">@Model.Summary.SoDonThatBai</div>
        <div class="text-sm font-semibold text-gray-500 uppercase tracking-wide mt-2">Đơn thất bại</div>
    </div>
</div>

<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 mb-8">
    <h6 class="text-lg font-bold text-gray-800 mb-6">Biểu đồ doanh thu <span class="text-sm font-normal text-gray-500 ml-2">(@Model.TuNgayLoc.ToString("dd/MM/yyyy") - @Model.DenNgayLoc.ToString("dd/MM/yyyy"))</span></h6>
    <div class="flex items-end h-64 gap-2 border-b border-gray-200 pb-2 mt-4 relative">
        @foreach (var ngay in Model.TheoNgay)
        {
            var phanTram = maxNgay > 0 ? (double)(ngay.DoanhThu / maxNgay) * 100 : 0;
            <div class="flex-1 flex flex-col items-center justify-end h-full group" title="@ngay.Ngay.ToString("dd/MM"): @ngay.DoanhThu.ToString("N0")VNĐ">
                <div class="w-full bg-freshgo/70 group-hover:bg-freshgo rounded-t-md transition-all duration-300 ease-in-out" style="height:@(Math.Max(phanTram, 2))%"></div>
                <div class="text-xs text-gray-500 mt-2 rotate-45 md:rotate-0 origin-left">@ngay.Ngay.ToString("dd/MM")</div>
            </div>
        }
    </div>
</div>

<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100" id="don-hang-gan-day">
    <div class="flex justify-between items-center mb-6">
        <h6 class="text-lg font-bold text-gray-800 m-0">Đơn hàng gần đây</h6>
        <form method="get" action="#don-hang-gan-day" class="flex items-center gap-2">
            <input type="hidden" name="khoangThoiGian" value="@Model.KhoangThoiGian" />
            <input type="hidden" name="tuNgay" value="@Model.TuNgayLoc.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="denNgay" value="@Model.DenNgayLoc.ToString("yyyy-MM-dd")" />
            <select name="trangThaiLoc" class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-freshgo outline-none bg-white text-gray-700 w-40 shadow-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Model.TrangThaiLoc))">Tất cả trạng thái</option>
                <option value="@TrangThaiDonOptions.HoanTat" selected="@(Model.TrangThaiLoc == TrangThaiDonOptions.HoanTat)">Hoàn tất</option>
                <option value="@TrangThaiDonOptions.DaHuy" selected="@(Model.TrangThaiLoc == TrangThaiDonOptions.DaHuy)">Đã hủy</option>
            </select>
        </form>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse whitespace-nowrap">
            <thead>
                <tr class="bg-gray-50/50 border-b-2 border-gray-200">
                    <th class="px-4 py-3 text-sm font-semibold text-gray-600">Mã đơn</th>
                    <th class="px-4 py-3 text-sm font-semibold text-gray-600">Ngày đặt</th>
                    <th class="px-4 py-3 text-sm font-semibold text-gray-600">Tổng thanh toán</th>
                    <th class="px-4 py-3 text-sm font-semibold text-gray-600">Phương thức</th>
                    <th class="px-4 py-3 text-sm font-semibold text-gray-600">Trạng thái</th>
                    <th class="px-4 py-3 text-sm font-semibold text-gray-600">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var don in Model.DonGanDay)
                {
                    <tr class="hover:bg-gray-50 transition-colors duration-150">
                        <td class="px-4 py-4 text-sm font-medium text-gray-900">#@don.MaDonHang</td>
                        <td class="px-4 py-4 text-sm text-gray-500">@don.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-4 py-4 text-sm font-bold text-gray-700">@don.TongThanhToan.ToString("N0")đ</td>
                        <td class="px-4 py-4 text-sm text-gray-600">@don.PhuongThucLabel</td>
                        <td class="px-4 py-4">
                            <span class="px-3 py-1 rounded-full text-xs font-semibold @(don.ThanhCong ? "bg-green-100 text-green-700 border border-green-200" : "bg-red-100 text-red-700 border border-red-200")">
                                @don.TrangThaiLabel
                            </span>
                        </td>
                        <td class="px-4 py-4">
                            <a class="inline-flex items-center justify-center px-3 py-1.5 border border-freshgo text-freshgo hover:bg-freshgo hover:text-white rounded-md text-xs font-medium transition-all duration-200 shadow-sm" asp-page="/Manager/DonHang/ChiTiet" asp-route-id="@don.MaDonHang">
                                Xem chi tiết
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.DonGanDay.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-gray-400 py-8 text-sm italic">
                            Chưa có dữ liệu đơn hàng trong khoảng thời gian này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function capNhatHienThiTuyChon() {
            var laTuyChon = document.getElementById('khoangThoiGian').value === 'tuychon';
            document.getElementById('khoiTuyChon').style.display = laTuyChon ? 'flex' : 'none';
        }
        capNhatHienThiTuyChon();
    </script>
}