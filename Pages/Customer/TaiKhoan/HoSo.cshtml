@page
@* @model FreshGo.Pages.Customer.TaiKhoan.HoSoModel *@
@{
    ViewData["Title"] = "Hồ Sơ Của Tôi";
    Layout = "_CustomerLayout";
}

<div class="container py-5 mt-3">
    <div class="row g-4">
        <!-- CỘT TRÁI: MENU TÀI KHOẢN -->
        <div class="col-lg-3">
            <div class="d-flex align-items-center gap-3 mb-4 px-2">
                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 50px; height: 50px;">
                    TK
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Khách Trần B</h6>
                    <span class="text-muted small"><i class="bi bi-pencil-square"></i> Sửa hồ sơ</span>
                </div>
            </div>
            
            <div class="list-group border-0 shadow-sm rounded-4 overflow-hidden">
                <a asp-page="/Customer/TaiKhoan/HoSo" class="list-group-item list-group-item-action active bg-success border-success py-3 fw-medium">
                    <i class="bi bi-person-circle me-2"></i> Hồ sơ của tôi
                </a>
                <a asp-page="/Customer/TaiKhoan/DoiMatKhau" class="list-group-item list-group-item-action py-3 fw-medium text-dark">
                    <i class="bi bi-shield-lock me-2"></i> Đổi mật khẩu
                </a>
                <a href="#" class="list-group-item list-group-item-action py-3 fw-medium text-dark">
                    <i class="bi bi-receipt me-2"></i> Đơn mua của tôi
                </a>
            </div>
        </div>

        <!-- CỘT PHẢI: NỘI DUNG HỒ SƠ -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom p-4 rounded-top-4">
                    <h5 class="fw-black m-0" style="font-weight: 800;">Hồ Sơ Của Tôi</h5>
                    <p class="text-muted m-0 mt-1">Quản lý thông tin hồ sơ để bảo mật tài khoản</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div class="row mb-4 align-items-center">
                            <label class="col-sm-3 col-form-label fw-semibold text-muted text-sm-end">Tên đăng nhập</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control border-0 bg-light fw-bold" value="khach1" readonly>
                                <div class="form-text">Tên đăng nhập không thể thay đổi.</div>
                            </div>
                        </div>

                        <div class="row mb-4 align-items-center">
                            <label class="col-sm-3 col-form-label fw-semibold text-muted text-sm-end">Họ và tên</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control shadow-none border-success-subtle" value="Khách Trần B" required>
                            </div>
                        </div>

                        <div class="row mb-4 align-items-center">
                            <label class="col-sm-3 col-form-label fw-semibold text-muted text-sm-end">Số điện thoại</label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-success-subtle">+84</span>
                                    <input type="text" class="form-control shadow-none border-success-subtle" value="0900000004" required>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-9 offset-sm-3">
                                <button type="submit" class="btn btn-success px-5 py-2 rounded-pill fw-bold shadow-sm">
                                    LƯU THAY ĐỔI
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>