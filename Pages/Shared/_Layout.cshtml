@using System.Security.Claims
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "FreshGo";
    var isAdmin = User.IsInRole(Roles.Admin);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - FreshGo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<header>
<nav class="navbar navbar-expand-lg navbar-dark fresh-navbar">
  <div class="container">
    <a class="navbar-brand fw-bold" asp-page="/Index"><span class="brand-mark">F</span> FreshGo</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        @if (isAdmin) {
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Index">Tổng quan</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Products/Index">Sản phẩm</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Orders/Index">Đơn hàng</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/StockRequests/Index">Duyệt nhập kho</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Branches/Index">Chi nhánh</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Staff/Index">Nhân sự</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Vouchers/Index">Voucher</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Events/Index">Sự kiện</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Defects/Index">Hàng lỗi</a></li>
          <li class="nav-item"><a class="nav-link" asp-page="/Admin/Gifts/Index">Quà đổi điểm</a></li>
        }
      </ul>
      <div class="d-flex align-items-center gap-2">
        @if (User.Identity?.IsAuthenticated == true) {
          <span class="text-white-50 small d-none d-md-inline">Xin chào, @User.Identity.Name</span>
          <form method="post" asp-page="/Account/Logout"><button class="btn btn-outline-light btn-sm">Đăng xuất</button></form>
        } else {
          <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login">Đăng nhập</a>        }
      </div>
    </div>
  </div>
</nav>
</header>
<main class="container py-4">
    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
</main>
<footer class="footer mt-5"><div class="container d-flex flex-column flex-md-row justify-content-between gap-2"><span>© @DateTime.Now.Year FreshGo – Thực phẩm tươi mỗi ngày</span><span>Hotline: 1900 0000 · Hỗ trợ khách hàng</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
