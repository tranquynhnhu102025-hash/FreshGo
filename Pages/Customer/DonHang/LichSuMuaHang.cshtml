@page
@model FreshGo.Pages.Customer.DonHang.LichSuMuaHangModel
@{
    ViewData["Title"] = "Đơn Mua Của Tôi - FreshGo";
}

<style>
    .om-wrap, .om-wrap * { box-sizing: border-box; }
    .om-wrap {
        width: 100%;
        max-width: 100%;
        margin: 8px 0 40px;
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }
    @@media (max-width: 860px) { .om-wrap { grid-template-columns: 1fr; } }

    .om-side {
        background: #fff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
    }
    .om-main {
        background: #fff;
        border-radius: 16px;
        padding: 26px 28px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        min-width: 0;
    }
    .om-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #198754;
        color: #fff;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }
    .om-menu-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: #334155;
        font-weight: 600;
        font-size: 14px;
        margin-top: 6px;
        transition: background .15s;
    }
    .om-menu-item:hover { background: #f1f5f9; color: #198754; }
    .om-menu-item.active { background: #198754; color: #fff; }

    .om-tabs {
        display: flex;
        gap: 22px;
        border-bottom: 1px solid #e2e8f0;
        margin: 18px 0 20px;
        flex-wrap: wrap;
    }
    .om-tab {
        padding: 10px 2px;
        font-weight: 700;
        font-size: 14px;
        color: #64748b;
        cursor: pointer;
        border: none;
        border-bottom: 3px solid transparent;
        background: transparent;
    }
    .om-tab.active { color: #198754; border-bottom-color: #198754; }

    .om-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 16px;
        background: #fff;
    }
    .om-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
        flex-wrap: wrap;
    }
    .om-badge {
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 700;
        white-space: nowrap;
    }
    .st-cho { background: #fef3c7; color: #b45309; }
    .st-giao { background: #e0f2fe; color: #0369a1; }
    .st-xong { background: #dcfce7; color: #15803d; }
    .st-huy { background: #fee2e2; color: #b91c1c; }

    .om-card-mid {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px 0;
    }
    .om-card-bot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 12px;
        border-top: 1px solid #f1f5f9;
        flex-wrap: wrap;
        gap: 12px;
    }
    .om-btn-detail {
        background: #198754;
        color: #fff !important;
        text-decoration: none;
        padding: 8px 18px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 13px;
        white-space: nowrap;
        display: inline-block;
    }
    .om-btn-detail:hover { background: #157347; }
</style>

<div class="om-wrap">
    <aside class="om-side">
        <div style="display:flex; align-items:center; gap:12px; padding-bottom:16px; border-bottom:1px solid #f1f5f9; margin-bottom:10px;">
            <div class="om-avatar">TK</div>
            <div>
                <div style="font-weight:800; color:#0f172a; font-size:15px;">@Model.TenKhachHang</div>
                <a asp-page="/Customer/TaiKhoan/HoSo" style="font-size:12.5px; color:#64748b; text-decoration:none;">✏️ Sửa hồ sơ</a>
            </div>
        </div>
        <a asp-page="/Customer/TaiKhoan/HoSo" class="om-menu-item">👤 Hồ sơ của tôi</a>
        <a asp-page="/Customer/TaiKhoan/DoiMatKhau" class="om-menu-item">🔒 Đổi mật khẩu</a>
        <a asp-page="/Customer/DonHang/LichSuMuaHang" class="om-menu-item active">📋 Đơn mua của tôi</a>
    </aside>

    <main class="om-main">
        <h1 style="font-size:22px; font-weight:800; color:#0f172a; margin:0 0 4px;">Đơn Mua Của Tôi</h1>
        <p style="color:#64748b; font-size:13.5px; margin:0;">Quản lý và theo dõi trạng thái các đơn hàng bạn đã đặt</p>

        <div class="om-tabs">
            <button type="button" class="om-tab active" onclick="filterOrders('ALL', this)">Tất cả (@Model.DanhSachDon.Count)</button>
            <button type="button" class="om-tab" onclick="filterOrders('Chờ', this)">Chờ duyệt</button>
            <button type="button" class="om-tab" onclick="filterOrders('Đang giao', this)">Đang giao</button>
            <button type="button" class="om-tab" onclick="filterOrders('Đã giao', this)">Đã giao</button>
            <button type="button" class="om-tab" onclick="filterOrders('Đã hủy', this)">Đã hủy</button>
        </div>

        @if (!Model.DanhSachDon.Any())
        {
            <div style="text-align:center; padding:40px 20px; color:#64748b;">
                Bạn chưa có đơn hàng nào. <a asp-page="/Customer/TrangChu/Index" style="color:#198754; font-weight:700;">Mua sắm ngay →</a>
            </div>
        }
        else
        {
            foreach (var don in Model.DanhSachDon)
            {
                string badgeClass = don.TrangThai.Contains("Đang giao") ? "st-giao"
                    : (don.TrangThai.Contains("Đã giao") || don.TrangThai.Contains("Hoàn")) ? "st-xong"
                    : don.TrangThai.Contains("Hủy") ? "st-huy" : "st-cho";

                <div class="om-card" data-status="@don.TrangThai">
                    <div class="om-card-top">
                        <span style="font-weight:800; color:#1e293b; font-size:14.5px;">📦 Mã đơn: @don.MaDonHienThi</span>
                        <span class="om-badge @badgeClass">🚚 @don.TrangThai</span>
                    </div>

                    <div class="om-card-mid">
                        <div style="display:flex; align-items:center; gap:14px; min-width:0;">
                            @if (!string.IsNullOrEmpty(don.HinhAnhDauTien))
                            {
                                <img src="@don.HinhAnhDauTien" alt="@don.TenSanPhamDauTien" style="width:56px; height:56px; border-radius:10px; object-fit:cover; flex-shrink:0;" />
                            }
                            <div style="min-width:0;">
                                <div style="font-weight:700; color:#0f172a; font-size:15px;">
                                    @don.TenSanPhamDauTien
                                    @if (don.TongSoMon > 1)
                                    {
                                        <span style="font-size:12.5px; color:#198754; font-weight:700;">(+@(don.TongSoMon - 1) sản phẩm khác)</span>
                                    }
                                </div>
                                <div style="font-size:13px; color:#64748b; margin-top:2px;">
                                    Số lượng: @don.SoLuongDauTien @don.DonViTinhDauTien
                                </div>
                                @if (!string.IsNullOrEmpty(don.DiaChiGiao))
                                {
                                    <div style="font-size:12.5px; color:#475569; margin-top:3px;">📍 @don.DiaChiGiao</div>
                                }
                            </div>
                        </div>
                        <div style="font-weight:800; color:#0f172a; font-size:14.5px; white-space:nowrap;">
                            @don.TongTien.ToString("N0")đ
                        </div>
                    </div>

                    <div class="om-card-bot">
                        <span style="font-size:13px; color:#64748b;">Ngày đặt: @don.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                        <div style="display:flex; align-items:center; gap:14px;">
                            <span style="font-size:13.5px; color:#334155;">Thành tiền: <strong style="color:#198754; font-size:18px;">@don.TongTien.ToString("N0")đ</strong></span>
                            <a asp-page="/Customer/DonHang/TheoDoiDon" asp-route-id="@don.IdDonHang" class="om-btn-detail">Xem Chi Tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
    </main>
</div>

<script>
    function filterOrders(keyword, btn) {
        document.querySelectorAll('.om-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.om-card').forEach(card => {
            const st = card.getAttribute('data-status') || '';
            card.style.display = (keyword === 'ALL' || st.includes(keyword)) ? 'block' : 'none';
        });
    }
</script>