@page
@model FreshGo.Pages.Manager.IndexModel
@{
    ViewData["Title"] = "Trang chủ Quản lý";
}

@if (Model.ChiNhanh is null)
{
    <div class="alert alert-warning">
        Không tìm thấy dữ liệu chi nhánh (MaChiNhanh = @BranchContext.CurrentBranchId).
        Kiểm tra lại kết nối CSDL trong <code>appsettings.json</code> và dữ liệu bảng <code>ChiNhanh</code>.
    </div>
}
else
{
    <div class="manager-card mb-4">
        <h4 class="mb-1">@Model.ChiNhanh.TenChiNhanh</h4>
        <div class="text-muted">@Model.ChiNhanh.DiaChi (@Model.ChiNhanh.KhuVucQuan)</div>
    </div>

    <div class="manager-card mb-4 d-flex justify-content-between align-items-center">
        <div>
            <div class="label text-muted">Doanh thu hôm nay</div>
            <div class="value" style="font-size:1.8rem">@Model.DoanhThuHomNay.TongDoanhThu.ToString("N0")VNĐ</div>
            <div class="text-muted">@Model.DoanhThuHomNay.SoDonHoanTat đơn hoàn tất</div>
        </div>
        <a class="btn btn-outline-primary" asp-page="/Manager/DoanhThu/Index">Xem doanh thu chi tiết</a>
    </div>

    <div class="row g-3">
        <div class="col-md-2 col-6">
            <div class="manager-stat">
                <div class="value">@Model.Stats.TongMatHang</div>
                <div class="label">Mặt hàng đang kinh doanh</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="manager-stat">
                <div class="value">@Model.Stats.TongSoLuongTon</div>
                <div class="label">Tổng số lượng tồn</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="manager-stat">
                <div class="value text-success">@Model.Stats.SoMatHangConHang</div>
                <div class="label">Còn hàng</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="manager-stat">
                <div class="value text-secondary">@Model.Stats.SoMatHangHetHang</div>
                <div class="label">Hết hàng</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="manager-stat">
                <div class="value text-danger">@Model.Stats.SoMatHangLoiHu</div>
                <div class="label">Có hàng lỗi/hư</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="manager-stat">
                <div class="value" style="color:#dc2626">@Model.Stats.SoMatHangHetHan</div>
                <div class="label">Hết hạn</div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-primary" asp-page="/Manager/TonKho/Index">Xem tồn kho</a>
        <a class="btn btn-outline-secondary" asp-page="/Manager/ThongTinChiNhanh">Thông tin chi nhánh</a>
    </div>
}
