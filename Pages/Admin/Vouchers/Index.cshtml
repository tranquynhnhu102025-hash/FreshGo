@page
@model FreshGo.Pages.Admin.Vouchers.IndexModel
@{
    ViewData["Title"] = "Quản lý voucher";
}
<div class="page-heading"><div><div class="eyebrow">PROMOTION CENTER</div><h1 class="h2 fw-bold">Quản lý voucher</h1><p class="text-secondary mb-0">Tạo mã giảm giá, giới hạn lượt dùng và thời gian áp dụng.</p></div></div>
<div class="row g-3"><div class="col-lg-4"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Tạo voucher</div><div class="card-body"><form method="post"><div asp-validation-summary="All" class="text-danger small"></div><div class="mb-2"><label class="form-label">Mã voucher</label><input asp-for="Input.Code" class="form-control text-uppercase" required /></div><div class="mb-2"><label class="form-label">Tên chương trình</label><input asp-for="Input.Name" class="form-control" /></div><div class="row"><div class="col-6 mb-2"><label class="form-label">Giảm (%)</label><input asp-for="Input.DiscountPercent" type="number" step="0.5" min="1" max="100" class="form-control" /></div><div class="col-6 mb-2"><label class="form-label">Giảm tối đa</label><input asp-for="Input.MaxDiscount" type="number" min="0" class="form-control" /></div></div><div class="row"><div class="col-6 mb-2"><label class="form-label">Đơn tối thiểu</label><input asp-for="Input.MinOrderValue" type="number" min="0" class="form-control" /></div><div class="col-6 mb-2"><label class="form-label">Số lượt</label><input asp-for="Input.Quantity" type="number" min="1" class="form-control" /></div></div><div class="mb-2"><label class="form-label">Bắt đầu</label><input asp-for="Input.StartAt" type="datetime-local" class="form-control" /></div><div class="mb-3"><label class="form-label">Kết thúc</label><input asp-for="Input.EndAt" type="datetime-local" class="form-control" /></div><button class="btn btn-success w-100">Tạo voucher</button></form></div></div></div>
<div class="col-lg-8"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Danh sách voucher</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã</th><th>Ưu đãi</th><th>Lượt còn</th><th>Thời hạn</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var v in Model.Vouchers) { <tr><td><strong>@v.Code</strong><div class="small text-secondary">@v.Name</div></td><td>@v.DiscountPercent% · tối đa @v.MaxDiscount.ToString("N0") đ</td><td>@v.Quantity</td><td class="small">@v.StartAt.ToLocalTime().ToString("dd/MM/yy") – @v.EndAt.ToLocalTime().ToString("dd/MM/yy")</td><td>@(v.IsActive ? "Đang bật" : "Đã tắt")</td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@v.Id"/><button class="btn btn-sm btn-outline-secondary">@(v.IsActive ? "Tắt" : "Bật")</button></form></td></tr> }</tbody></table></div></div></div></div>
