@page
@model FreshGo.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Toàn bộ đơn hàng";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">ORDER MONITORING</div>
        <h1 class="h2 fw-bold">Toàn bộ đơn hàng</h1>
        <p class="text-secondary mb-0">Admin theo dõi đơn hàng của tất cả chi nhánh.</p>
    </div>
</div>

<div class="card dashboard-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Chi nhánh</th>
                    <th>Khách hàng</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th>Thanh toán</th>
                    <th class="text-end">Tổng tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td class="fw-semibold">@o.Code</td>
                        <td>@o.BranchName</td>
                        <td>
                            @o.CustomerName
                            <div class="small text-secondary">@o.CustomerPhone</div>
                        </td>
                        <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="status-pill">@o.Status</span></td>
                        <td>@o.PaymentMethod · @o.PaymentStatus</td>
                        <td class="text-end fw-semibold">@o.TotalAmount.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>