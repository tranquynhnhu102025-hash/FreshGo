@page
@model FreshGo.Pages.Admin.Branches.IndexModel
@{
    ViewData["Title"] = "Quản lý chi nhánh";
}
<div class="page-heading"><div><div class="eyebrow">BRANCH NETWORK</div><h1 class="h2 fw-bold">Quản lý chi nhánh</h1><p class="text-secondary mb-0">Tạo điểm bán và liên kết kho riêng cho từng chi nhánh.</p></div></div>
<div class="row g-3"><div class="col-lg-4"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Thêm chi nhánh</div><div class="card-body"><form method="post" asp-page-handler="Create"><div asp-validation-summary="All" class="text-danger small"></div><div class="mb-2"><label class="form-label">Tên chi nhánh</label><input asp-for="Input.Name" class="form-control" required /></div><div class="mb-2"><label class="form-label">Địa chỉ</label><textarea asp-for="Input.Address" class="form-control" required></textarea></div><div class="mb-2"><label class="form-label">Số điện thoại</label><input asp-for="Input.Phone" class="form-control" /></div><div class="mb-3"><label class="form-label">Link bản đồ (tuỳ chọn)</label><input asp-for="Input.MapUrl" class="form-control" placeholder="https://maps.google.com/..." /></div><button class="btn btn-success w-100">Tạo chi nhánh</button></form></div></div></div>
<div class="col-lg-8"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Danh sách chi nhánh</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Chi nhánh</th><th>Địa chỉ</th><th>Liên hệ</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var b in Model.Branches) { <tr><td class="fw-semibold">@b.Name</td><td>@b.Address</td><td>@b.Phone</td><td>@(b.IsActive ? "Hoạt động" : "Đã đóng")</td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@b.Id"/><button class="btn btn-sm btn-outline-secondary">@(b.IsActive ? "Đóng" : "Mở")</button></form></td></tr> }</tbody></table></div></div></div></div>
