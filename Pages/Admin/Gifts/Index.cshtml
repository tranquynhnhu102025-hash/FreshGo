@page
@model FreshGo.Pages.Admin.Gifts.IndexModel
@{
    ViewData["Title"] = "Quà đổi điểm";
}
<div class="page-heading"><div><div class="eyebrow">LOYALTY REWARDS</div><h1 class="h2 fw-bold">Quản lý quà đổi điểm</h1><p class="text-secondary mb-0">Tạo quà tặng và thiết lập số điểm khách hàng cần sử dụng.</p></div></div>
<div class="row g-3"><div class="col-lg-4"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Thêm quà tặng</div><div class="card-body"><form method="post"><div asp-validation-summary="All" class="text-danger small"></div><div class="mb-2"><label class="form-label">Tên quà</label><input asp-for="Input.Name" class="form-control" required /></div><div class="mb-2"><label class="form-label">Mô tả</label><textarea asp-for="Input.Description" class="form-control"></textarea></div><div class="mb-2"><label class="form-label">Điểm cần đổi</label><input asp-for="Input.PointsRequired" type="number" min="1" class="form-control" /></div><div class="mb-3"><label class="form-label">Số lượng</label><input asp-for="Input.Quantity" type="number" min="0" class="form-control" /></div><button class="btn btn-success w-100">Thêm quà</button></form></div></div></div>
<div class="col-lg-8"><div class="card dashboard-card"><div class="card-header bg-white fw-bold">Kho quà tặng</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Tên quà</th><th>Điểm</th><th>Số lượng còn</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var g in Model.Gifts) { <tr><td class="fw-semibold">@g.Name<div class="small text-secondary">@g.Description</div></td><td>@g.PointsRequired</td><td>@g.Quantity</td><td>@(g.IsActive ? "Đang mở" : "Đã ẩn")</td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@g.Id"/><button class="btn btn-sm btn-outline-secondary">@(g.IsActive ? "Ẩn" : "Mở")</button></form></td></tr> }</tbody></table></div></div></div></div>
