@page
@model FreshGo.Pages.Customer.KhuyenMai.IndexModel
@{
    ViewData["Title"] = "Khuyến mãi & Ưu đãi - FreshGo";
}

<div class="container py-4">
    <!-- Banner Khuyến Mãi -->
    <div class="rounded-4 p-4 p-md-5 mb-5 text-white shadow-sm position-relative overflow-hidden"
         style="background: linear-gradient(135deg, #0d5c3e 0%, #198754 60%, #20c997 100%);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-3">
                    🔥 SIÊU HỘI NÔNG SẢN SẠCH
                </span>
                <h1 class="display-5 fw-bold mb-3">Săn Voucher Tươi Ngon – Tiết Kiệm Đến 30%</h1>
                <p class="lead mb-4 opacity-90">
                    Lưu hoặc bấm "Dùng ngay" để áp dụng mã giảm giá trực tiếp trong giỏ hàng FreshGo.
                </p>
                <div class="d-inline-flex align-items-center gap-2 bg-dark bg-opacity-25 px-3 py-2 rounded-3">
                    <span>⏳ Kết thúc sau:</span>
                    <span id="flash-timer" class="fw-bold text-warning fs-5">02 : 45 : 30</span>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <div style="font-size: 6.5rem; line-height: 1;">🧺🥬🍎</div>
            </div>
        </div>
    </div>

    <!-- Danh sách Voucher -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-success mb-0">🎟️ Kho Mã Giảm Giá Đang Có</h3>
        <span class="text-muted small">Bấm "Dùng ngay" để chuyển mã sang giỏ hàng</span>
    </div>

    <div class="row g-3 mb-5">
        @if (Model.DanhSachVoucher.Any())
        {
            foreach (var v in Model.DanhSachVoucher)
            {
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                        <div class="row g-0 h-100">
                            <div class="col-4 bg-success text-white d-flex flex-column justify-content-center align-items-center p-3 text-center">
                                <span class="fs-2 fw-extrabold">GIẢM @v.PhanTramGiam%</span>
                                <span class="badge bg-warning text-dark mt-1">@v.MaVoucher</span>
                            </div>
                            <div class="col-8 p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="fw-bold mb-1">
                                        Giảm @v.PhanTramGiam% @(v.GiamToiDa.HasValue ? $"(tối đa {v.GiamToiDa.Value:N0}đ)" : "")
                                    </h5>
                                    <p class="text-muted small mb-2">
                                        Còn lại: <strong>@v.SoLuong</strong> lượt •
                                        HSD: @(v.NgayHetHan?.ToString("dd/MM/yyyy") ?? "Không giới hạn")
                                    </p>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button"
                                            class="btn btn-outline-success btn-sm fw-semibold rounded-pill px-3"
                                            onclick="copyVoucher('@v.MaVoucher', this)">
                                        📋 Sao chép mã
                                    </button>
                                    <form method="post" asp-page-handler="DungMa" class="d-inline">
                                        <input type="hidden" name="maVoucher" value="@v.MaVoucher" />
                                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                                            Dùng ngay
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light border rounded-3">Hiện chưa có mã giảm giá nào khả dụng.</div>
            </div>
        }
    </div>

    <!-- Sản phẩm Giá Sốc Hôm Nay -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-success mb-0">⚡ Nông Sản Ưu Đãi Trong Ngày</h3>
        <a asp-page="/Customer/TrangChu/Index" class="text-success fw-semibold text-decoration-none">
            Xem tất cả cửa hàng →
        </a>
    </div>

    <div class="row g-4">
        @foreach (var sp in Model.SanPhamGiamGia)
        {
            var giaGoc = sp.GiaBan * 1.2m;
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(sp.HinhAnh) ? "https://images.unsplash.com/photo-1542838132-92c53300491e?w=600" : sp.HinhAnh)"
                             class="card-img-top" alt="@sp.TenSanPham"
                             style="height: 180px; object-fit: cover;">
                        <span class="badge bg-danger position-absolute top-0 start-0 m-2 rounded-pill">-17%</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="fw-bold mb-1 text-truncate">@sp.TenSanPham</h6>
                        <p class="text-muted small mb-2 text-truncate">@sp.MoTa</p>
                        <div class="mt-auto">
                            <div class="text-muted text-decoration-line-through small">@giaGoc.ToString("N0")đ</div>
                            <div class="fs-5 fw-bold text-danger mb-2">@sp.GiaBan.ToString("N0")đ</div>
                            <form method="post" asp-page-handler="MuaNgay">
                                <input type="hidden" name="sanPhamId" value="@sp.Id" />
                                <button type="submit" class="btn btn-success w-100 rounded-pill btn-sm fw-semibold">
                                    🛒 Mua ngay
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function copyVoucher(code, btn) {
            navigator.clipboard.writeText(code);
            const oldText = btn.innerHTML;
            btn.innerHTML = "✅ Đã chép " + code;
            btn.classList.replace("btn-outline-success", "btn-success");
            setTimeout(() => {
                btn.innerHTML = oldText;
                btn.classList.replace("btn-success", "btn-outline-success");
            }, 2000);
        }

        let totalSeconds = 2 * 3600 + 45 * 60 + 30;
        setInterval(() => {
            if (totalSeconds <= 0) return;
            totalSeconds--;
            const h = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
            const s = String(totalSeconds % 60).padStart(2, '0');
            const el = document.getElementById('flash-timer');
            if (el) el.textContent = `${h} : ${m} : ${s}`;
        }, 1000);
    </script>
}