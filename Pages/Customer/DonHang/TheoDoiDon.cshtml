@page
@model FreshGo.Pages.Customer.DonHang.TheoDoiDonModel
@{
    ViewData["Title"] = $"Chi tiết đơn hàng {Model.MaDonHienThi} - FreshGo";
    int step = Model.TrangThai.Contains("Đã giao") || Model.TrangThai.Contains("Hoàn") ? 3
             : Model.TrangThai.Contains("Đang giao") ? 2 : 1;
}

<div style="max-width: 900px; margin: 28px auto 60px; padding: 0 20px; font-family: 'Segoe UI', system-ui, sans-serif;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h1 style="font-size:24px; font-weight:800; color:#0f172a; margin:0;">📦 Chi Tiết Đơn Hàng @Model.MaDonHienThi</h1>
        <a asp-page="/Customer/DonHang/LichSuMuaHang" style="text-decoration:none; color:#059669; font-weight:700; background:#ecfdf5; padding:8px 16px; border-radius:999px;">← Quay lại danh sách đơn</a>
    </div>

    <div style="background:#fff; border-radius:20px; padding:26px; border:1px solid #e2e8f0; box-shadow:0 4px 16px rgba(15,23,42,.04);">
        <!-- Thanh tiến trình -->
        <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:12px; text-align:center; padding-bottom:22px; border-bottom:1px solid #f1f5f9;">
            <div style="padding:12px; border-radius:14px; background:@(step >= 1 ? "#ecfdf5" : "#f8fafc"); color:@(step >= 1 ? "#059669" : "#94a3b8"); font-weight:700;">
                1. Chờ duyệt / Xác nhận
            </div>
            <div style="padding:12px; border-radius:14px; background:@(step >= 2 ? "#e0f2fe" : "#f8fafc"); color:@(step >= 2 ? "#0284c7" : "#94a3b8"); font-weight:700;">
                2. Shipper đang giao hàng
            </div>
            <div style="padding:12px; border-radius:14px; background:@(step >= 3 ? "#dcfce7" : "#f8fafc"); color:@(step >= 3 ? "#15803d" : "#94a3b8"); font-weight:700;">
                3. Giao hàng thành công
            </div>
        </div>

        <div style="padding:16px 0; border-bottom:1px solid #f1f5f9; font-size:14.5px; color:#334155; line-height:1.7;">
            <div><strong>Trạng thái hiện tại:</strong> <span style="color:#059669; font-weight:800;">@Model.TrangThai</span></div>
            <div><strong>Thời gian đặt:</strong> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</div>
            <div><strong>Thông tin & Địa chỉ giao hàng:</strong> @Model.DiaChiGiao</div>
        </div>

        <h3 style="font-size:16px; font-weight:800; color:#0f172a; margin:18px 0 12px;">🛒 Danh sách sản phẩm đã đặt</h3>
        @foreach (var sp in Model.DanhSachMon)
        {
            <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px dashed #e2e8f0;">
                <div style="display:flex; align-items:center; gap:12px;">
                    @if (!string.IsNullOrEmpty(sp.HinhAnh))
                    {
                        <img src="@sp.HinhAnh" alt="@sp.TenSanPham" style="width:52px; height:52px; border-radius:10px; object-fit:cover;" />
                    }
                    <div>
                        <div style="font-weight:700; color:#0f172a;">@sp.TenSanPham</div>
                        <div style="font-size:13px; color:#64748b;">@sp.DonGia.ToString("N0")đ × @sp.SoLuong @sp.DonViTinh</div>
                    </div>
                </div>
                <strong style="color:#059669;">@sp.ThanhTien.ToString("N0")đ</strong>
            </div>
        }

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:18px; padding-top:14px;">
            <span style="font-size:16px; font-weight:700;">Tổng thanh toán:</span>
            <strong style="font-size:24px; color:#059669;">@Model.TongTien.ToString("N0")đ</strong>
        </div>
    </div>
</div>