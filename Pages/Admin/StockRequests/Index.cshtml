@page
@model FreshGo.Pages.Admin.StockRequests.IndexModel
@{
    ViewData["Title"] = "Duyệt yêu cầu nhập kho";
}
<div class="page-heading"><div><div class="eyebrow">WAREHOUSE TRANSFERS</div><h1 class="h2 fw-bold">Duyệt yêu cầu nhập kho</h1><p class="text-secondary mb-0">Admin duyệt yêu cầu và điều chuyển hàng từ kho tổng đến chi nhánh.</p></div></div>
<div class="card dashboard-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Chi nhánh</th><th>Sản phẩm</th><th>Số lượng</th><th>Người yêu cầu</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var r in Model.Requests) { <tr><td class="fw-semibold">@r.Branch?.Name</td><td>@r.Product?.Name</td><td>@r.Quantity</td><td>@r.RequestedById</td><td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="status-pill">@r.Status</span></td><td>@if (r.Status == RequestStates.Pending) { <div class="d-flex gap-1"><form method="post" asp-page-handler="Approve"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-success">Duyệt</button></form><form method="post" asp-page-handler="Reject"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-outline-danger">Từ chối</button></form></div> }</td></tr> }
</tbody></table></div></div>
