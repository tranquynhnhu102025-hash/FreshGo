@page
@model FreshGo.Pages.Manager.TonKho.IndexModel
@{
    ViewData["Title"] = "Tồn kho";
    ViewData["Breadcrumb"] = "Tồn kho";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên sản phẩm..." style="width:260px" />
        <select name="DanhMuc" class="form-select" style="width:200px" onchange="this.form.submit()">
            <option value="">Tất cả danh mục</option>
            @foreach (var dm in Model.DanhMucList)
            {
                <option value="@dm.MaDanhMuc" selected="@(Model.DanhMuc == dm.MaDanhMuc)">@dm.TenDanhMuc</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary">Tìm</button>
    </form>
    <div class="d-flex gap-2">
        <a class="btn btn-success" asp-page="/Manager/TonKho/YeuCauHang">Yêu cầu hàng</a>
        <a class="btn btn-primary" asp-page="/Manager/TonKho/Create">+ Thêm mặt hàng</a>
    </div>
</div>

<div class="manager-card">
    <table class="table manager-table align-middle">
        <thead>
            <tr>
                <th>STT</th>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Đơn giá</th>
                <th>Tồn kho</th>
                <th>Lỗi/hư</th>
                <th>Hạn sử dụng</th>
                <th>Trạng thái</th>
                <th>Tác vụ</th>
            </tr>
        </thead>
        <tbody>
            @{ int stt = 1; }
            @foreach (var item in Model.DanhSach)
            {
                var badgeClass = item.TrangThaiKinhDoanh switch
                {
                    FreshGo.Pages.Manager.Models.TrangThaiOptions.HetHang => "badge-status-hethang",
                    FreshGo.Pages.Manager.Models.TrangThaiOptions.HetHan => "badge-status-hethan",
                    _ => "badge-status-conhang"
                };
                <tr>
                    <td>@(stt++)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                        {
                            <img src="@item.HinhAnh" class="thumb" alt="@item.TenThucPham" />
                        }
                        else
                        {
                            <div class="thumb"></div>
                        }
                    </td>
                    <td>@item.TenThucPham</td>
                    <td>@item.TenDanhMuc</td>
                    <td>@item.GiaBan.ToString("N0")VNĐ/@item.DonViTinh</td>
                    <td>@item.SoLuongTon</td>
                    <td>@item.SoLuongLoiHu</td>
                    <td>@(item.HanSuDung?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td><span class="badge @badgeClass">@item.TrangThaiLabel</span></td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Manager/TonKho/Edit" asp-route-id="@item.MaTonKho">Sửa</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.MaTonKho" class="d-inline"
                              onsubmit="return confirm('Ngừng kinh doanh mặt hàng này tại chi nhánh?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.DanhSach.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">Chưa có mặt hàng nào trong kho chi nhánh.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
